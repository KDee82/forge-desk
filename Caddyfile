{
	email admin@{$FORGE_DOMAIN}
	# The host nginx sits in front of this container, so take the visitor's real
	# address from it. Safe because the gateway is published on 127.0.0.1 only.
	servers {
		trusted_proxies static private_ranges
	}
}

# TLS is terminated by the host nginx (ports 80/443 already serve the Raven
# dashboard), which proxies to this container on 127.0.0.1:8081.
#
# Sign-in is handled by Forge Desk itself (one password, a session cookie), so
# there is no basic_auth here any more. Everything, including code-server at
# /ide/ and web apps at /proxy/<port>/, goes through that login.
http://{$FORGE_DOMAIN} {
	encode zstd gzip

	reverse_proxy desk:7700 {
		header_up X-Forwarded-Proto https
		# Terminals, the code editor and the desktop stream are long-lived connections.
		flush_interval -1
	}
}
