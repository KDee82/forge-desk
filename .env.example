# Public hostname, for example desk.example.com.
FORGE_DOMAIN=desk.example.com

# The Forge Desk password, stored as a bcrypt hash. Create one with:
#   docker compose run --rm --no-deps gateway caddy hash-password --plaintext 'choose-a-long-password'
# IMPORTANT: keep the SINGLE QUOTES. Bcrypt hashes contain "$" and Docker Compose
# would otherwise treat them as variables and corrupt the hash.
FORGE_PASSWORD_HASH='replace-with-a-real-bcrypt-hash'

# Time zone used by containers.
TZ=Africa/Nairobi

# CODE_SERVER_PASSWORD from version 1 is no longer used: code-server now sits
# behind the Forge Desk login. You can delete that line from your .env.
